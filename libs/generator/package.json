{
  "name": "@appstudio/generator",
  "version": "0.1.0",
  "private": true,
  "description": "Turns an AppStudio document into a complete, componentised Angular project.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@appstudio/schema": "*",
    "@appstudio/widgets": "*"
  },
  "sideEffects": false
}
